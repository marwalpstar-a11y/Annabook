# ----------------------------------------------------------------------
# AnnaBook Official - Hostinger / LiteSpeed Server Configuration
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. 301 Permanent Redirect: /index.html -> https://x1bet.ink/
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s\?] [NC]
  RewriteRule ^index\.html$ https://x1bet.ink/ [R=301,L,NE]

  # 2. 301 Permanent Redirect: /blog.html -> https://x1bet.ink/blog
  RewriteCond %{THE_REQUEST} \s/+blog\.html[\s\?] [NC]
  RewriteRule ^blog\.html$ https://x1bet.ink/blog [R=301,L,NE]

  # 3. Internal Rewrite: Map /blog and /blog/ to blog.html
  RewriteRule ^blog/?$ blog.html [L,QSA]

  # 4. Clean URLs for other pages if accessed without extension
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# Disable directory browsing
Options -Indexes

# Core MIME types
<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/xml .xml
  AddType text/plain .txt
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/x-icon .ico
</IfModule>
